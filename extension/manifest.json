{
  "manifest_version": 3,
  "name": "SearchSuite — GSC & Bing Bulk Toolkit",
  "short_name": "SearchSuite",
  "version": "0.1.0",
  "key": "",
  "description": "Bulk URL inspection, indexing, removal and reporting for Google Search Console and Bing Webmaster Tools.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "storage",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://searchconsole.googleapis.com/*",
    "https://search.google.com/*",
    "https://api.indexnow.org/*",
    "https://*.indexnow.org/*",
    "https://ssl.bing.com/*",
    "https://www.bing.com/*"
  ],
  "oauth2": {
    "client_id": "939821183245-33g7jmlfap5brs9n0ogdgg2thrh5cnmb.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/webmasters",
      "https://www.googleapis.com/auth/webmasters.readonly"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://search.google.com/search-console/*"],
      "js": ["src/content/gsc-automation.js"],
      "run_at": "document_idle"
    }
  ]
}
